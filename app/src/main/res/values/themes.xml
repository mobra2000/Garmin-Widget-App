<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GarminWidget" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!--
        Kartenstapel im Widget: Android zeichnet beim Wischen einen dünnen Rand in der
        Primärfarbe um die Karte (beim Pixel fast schwarz). Mit transparenter Primärfarbe
        ist er unsichtbar.
    -->
    <style name="ThemeOverlay.GarminWidget.Stack" parent="android:Theme.DeviceDefault">
        <item name="android:colorPrimary">@android:color/transparent</item>
    </style>
</resources>
