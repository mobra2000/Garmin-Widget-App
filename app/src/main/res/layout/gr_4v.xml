<?xml version="1.0" encoding="utf-8"?>
<!-- Rastermodus (generiert) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sw_card_bg"
    android:backgroundTint="@color/sw_bg"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/gr_header"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/gr_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/sw_n_on"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/gr_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="4dp"
            android:src="@drawable/ic_refresh"
            android:tint="@color/sw_n_on" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/sw_tile_a"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/sw_tile_bg"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/sw_ring_a"
                    android:layout_width="96dp"
                    android:layout_height="96dp">

                    <ImageView
                        android:id="@+id/sw_track_a"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ring_track" />

                    <ImageView
                        android:id="@+id/sw_prog_a"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/sw_ricon_a"
                            android:layout_width="16dp"
                            android:layout_height="16dp" />

                        <TextView
                            android:id="@+id/sw_rvalue_a"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/sw_runit_a"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textSize="10sp" />
                    </LinearLayout>
                </FrameLayout>

                <ImageView
                    android:id="@+id/sw_icon_a"
                    android:layout_width="28dp"
                    android:layout_height="28dp" />

                <TextView
                    android:id="@+id/sw_value_a"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sw_sub_a"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

