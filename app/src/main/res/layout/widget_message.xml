<?xml version="1.0" encoding="utf-8"?>
<!-- Hinweis statt Werten -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/msg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sw_card_bg"
    android:backgroundTint="@color/sw_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_suggestion"
        android:tint="@color/sw_p_accent" />

    <TextView
        android:id="@+id/msg_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/sw_n_on"
        android:textSize="12sp" />
</LinearLayout>
