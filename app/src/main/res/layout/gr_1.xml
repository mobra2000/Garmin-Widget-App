<?xml version="1.0" encoding="utf-8"?>
<!-- Rastermodus: eine Kachel (generiert) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sw_tile_a"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sw_card_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/sw_ring_a"
            android:layout_width="96dp"
            android:layout_height="96dp">

            <ImageView
                android:id="@+id/sw_track_a"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/ring_track" />

            <ImageView
                android:id="@+id/sw_prog_a"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/sw_ricon_a"
                    android:layout_width="16dp"
                    android:layout_height="16dp" />

                <TextView
                    android:id="@+id/sw_rvalue_a"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sw_runit_a"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>

        <ImageView
            android:id="@+id/sw_icon_a"
            android:layout_width="28dp"
            android:layout_height="28dp" />

        <TextView
            android:id="@+id/sw_value_a"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sw_sub_a"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
